<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DataGenUI.VideoUploadWindow"
        Title="Frame Review"
        Width="560" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Choose a Video" FontSize="24" HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Server:" VerticalAlignment="Center"/>
            <TextBox x:Name="ServerBox" Text="http://localhost:15071" Width="220"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Interval (s):" VerticalAlignment="Center"/>
            <TextBox x:Name="IntervalBox" Text="1.0" Width="60"/>
            <TextBlock Text="Dedup tolerance:" VerticalAlignment="Center"/>
            <TextBox x:Name="ToleranceBox" Text="5" Width="60"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="OpenButton" Content="Open Video…" MinWidth="120" Click="OnOpenVideo"/>
            <Button x:Name="ClearButton" Content="Clear All Data" MinWidth="120" Click="OnClear"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="Pick a video to start reviewing frames."
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="ProgressText" Text="" HorizontalAlignment="Center"
                   Foreground="Gray"/>
    </StackPanel>
</Window>
